#!/usr/bin/env bash
#

echo "Cleaning up..."

# Check if podman exists, otherwise use docker
CONTAINER_CMD="docker"
if command -v podman &> /dev/null; then
    CONTAINER_CMD="podman"
fi

$CONTAINER_CMD stop showroom-server 2>/dev/null || true
rm -rf ./www/*
rm -rf ./.cache/*

echo "Cleanup complete."
